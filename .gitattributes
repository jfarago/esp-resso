# Normalize line endings to LF in the repo.
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bin binary
*.gz binary

# Keep shell scripts and hooks LF even on Windows checkouts.
*.sh text eol=lf
githooks/* text eol=lf

# Minified / vendored code: don't show in diffs or language stats.
ro-system-monitor/web/vendor/** linguist-vendored -diff
ro-system-monitor/web/support.js linguist-vendored -diff
